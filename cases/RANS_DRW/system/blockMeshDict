(
    (0 -60 0)
    (240 -60 0)
    (240 60 0)
    (0 60 0)
    (0 -60 120)
    (240 -60 120)
    (240 60 120)
    (0 60 120)
);

blocks
(
    hex (0 1 2 3 4 5 6 7) (24 12 12) simpleGrading (1 1 1)
);

edges              ();

boundary
(
    inlet
    {
        type            patch;
        faces
        (
            (0 4 7 3)
        );
    }

    outlet
    {
        type            patch;
        faces
        (
            (1 2 6 5)
        );
    }

    ground
    {
        type            wall;
        faces
        (
            (0 3 2 1)
        );
    }

    top
    {
        type            patch;
        faces
        (
            (4 5 6 7)
        );
    }

    sideA
    {
        type              cyclic;
        neighbourPatch    sideB;
        faces
        (
            (0 1 5 4)
        );
    }

    sideB
    {
        type              cyclic;
        neighbourPatch    sideA;
        faces
        (
            (3 7 6 2)
        );
    }
);

mergePatchPairs    ();

