FoamFile
{
    version         2.0;
    format          ascii;
    class           dictionary;
    object          turbulenceProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

simulationType    LES;

LES
{
    LESModel        kEqn;
    turbulence      on;
    printCoeffs     on;
    delta           cubeRootVol;

    kEqnCoeffs
    {
        Ce              0.93;
        Ck              0.094;
    }
}

